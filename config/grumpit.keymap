#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

#define DEF_L 0
#define NUM_L 1
#define SYM_L 2
#define CFG_L 3

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
    tapping-term-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_tab {
            timeout-ms = <25>;
            key-positions = <8 7>;
            bindings = <&kp TAB>;
            layers = <0 2>;
        };

        combo_bspc {
            timeout-ms = <25>;
            key-positions = <14 13>;
            bindings = <&kp BSPC>;
            layers = <0 2>;
        };

        combo_esc {
            timeout-ms = <30>;
            key-positions = <12 13 14>;
            bindings = <&kp ESC>;
            layers = <0 2>;
        };

        combo_soff {
            timeout-ms = <50>;
            key-positions = <6 15 26 27>;
            bindings = <&soft_off>;
        };

        combo_q {
            key-positions = <0 1>;
            bindings = <&kp DE_Q>;
            layers = <0>;
            timeout-ms = <25>;
        };

        combo_v {
            key-positions = <1 2>;
            bindings = <&kp DE_V>;
            layers = <0>;
            timeout-ms = <25>;
        };

        combo_dqt {
            key-positions = <5 4>;
            bindings = <&kp DE_DQT>;
            timeout-ms = <25>;
        };

        combo_sqt {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp DE_SINGLE_QUOTE>;
        };

        combo_osb {
            timeout-ms = <25>;
            key-positions = <1 7>;
            bindings = <&kp DE_LEFT_BRACKET>;
        };

        combo_ocb {
            timeout-ms = <25>;
            key-positions = <0 6>;
            bindings = <&kp DE_LEFT_BRACE>;
        };

        combo_opar {
            timeout-ms = <25>;
            key-positions = <2 8>;
            bindings = <&kp DE_LPAR>;
        };

        combo_cpar {
            timeout-ms = <25>;
            key-positions = <3 13>;
            bindings = <&kp DE_RPAR>;
        };

        combo_ccb {
            timeout-ms = <25>;
            key-positions = <5 15>;
            bindings = <&kp DE_RIGHT_BRACE>;
        };

        combo_csb {
            timeout-ms = <25>;
            key-positions = <4 14>;
            bindings = <&kp DE_RIGHT_BRACKET>;
        };

        combo_flsh {
            bindings = <&kp DE_SLASH>;
            key-positions = <18 9>;
            layers = <0>;
            timeout-ms = <25>;
        };

        combo_bslsh {
            bindings = <&kp DE_BACKSLASH>;
            key-positions = <23 12>;
            layers = <0>;
            timeout-ms = <25>;
        };

        combo_semi {
            bindings = <&kp DE_SEMI>;
            key-positions = <24 14>;
            timeout-ms = <25>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <9 8 7>;
            timeout-ms = <30>;
            layers = <0>;
        };

        combo_grave {
            bindings = <&kp DE_GRAVE>;
            key-positions = <5 3>;
            timeout-ms = <25>;
            layers = <1>;
        };

        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <9 12>;
        };

        combo_lt {
            bindings = <&kp DE_LESS_THAN>;
            key-positions = <0 9>;
            timeout-ms = <25>;
        };

        combo_gt {
            bindings = <&kp DE_GT>;
            key-positions = <3 14>;
            timeout-ms = <25>;
        };

        combo_pipe {
            bindings = <&kp DE_PIPE>;
            key-positions = <8 7 9>;
            layers = <1>;
            timeout-ms = <25>;
        };

        combo_ue {
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <5 26>;
            layers = <0>;
        };

        combo_ae {
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <26 15>;
            layers = <0>;
        };

        combo_oe {
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <26 4>;
            layers = <0>;
        };

        combo_sz {
            bindings = <&kp DE_CAPITAL_SHARP_S>;
            key-positions = <26 13>;
            layers = <0>;
        };

        combo_colon {
            bindings = <&kp DE_COLON>;
            key-positions = <15 25>;
        };

        combo_space {
            bindings = <&kp SPACE>;
            key-positions = <8 9>;
            timeout-ms = <30>;
            layers = <0 2>;
        };

        combo_cspace {
            bindings = <&kp LC(BSPC)>;
            key-positions = <13 12>;
            timeout-ms = <30>;
            layers = <0 2>;
        };

        combo_repeat {
            bindings = <&key_repeat>;
            key-positions = <7 9>;
            timeout-ms = <30>;
            layers = <0>;
        };

        combo_repeat_r {
            bindings = <&key_repeat>;
            key-positions = <12 14>;
            timeout-ms = <30>;
            layers = <0>;
        };

        combo_tilde {
            bindings = <&kp DE_TILDE>;
            key-positions = <2 0>;
            timeout-ms = <30>;
        };

        combo_unlock {
            bindings = <&studio_unlock>;
            key-positions = <17 18 19>;
        };

        combo_under {
            bindings = <&kp DE_UNDER>;
            key-positions = <7 2>;
            timeout-ms = <25>;
        };

        combo_minus {
            bindings = <&kp DE_MINUS>;
            key-positions = <3 14>;
            timeout-ms = <25>;
        };

        combo_p {
            bindings = <&kp DE_P>;
            key-positions = <3 12>;
            timeout-ms = <25>;
        };

        combo_y {
            bindings = <&kp DE_Y>;
            key-positions = <12 22>;
            timeout-ms = <25>;
        };

        combo_k {
            bindings = <&kp DE_K>;
            key-positions = <2 9>;
            timeout-ms = <25>;
        };

        combo_f {
            bindings = <&kp DE_F>;
            key-positions = <9 19>;
            timeout-ms = <25>;
        };

        combo_j {
            bindings = <&kp DE_J>;
            key-positions = <0 7>;
            timeout-ms = <25>;
        };
    };

    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <3 4 5 11 12 13 14 15 21 22 23 24 25 27>;
            hold-trigger-on-release;
        };

        layer_td: layer_td {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TD";
            #binding-cells = <0>;
            bindings = <&mt LEFT_SHIFT SPACE>, <&mo 2>;

            tapping-term-ms = <150>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            label = "HMR";
            hold-trigger-key-positions = <0 1 2 7 8 9 10 17 18 19 20 6 16>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                 &kp DE_L            &kp DE_D            &kp DE_Z                                                  &kp DE_W              &kp DE_O            &kp DE_U
&hml LCTRL DE_R  &hml LEFT_ALT DE_N  &hml LEFT_GUI DE_T  &hml LEFT_SHIFT DE_H  &kp DE_K      &kp DE_P              &hmr LEFT_SHIFT DE_C  &hmr LEFT_GUI DE_E  &hmr LEFT_ALT DE_I  &hmr LCTRL DE_A
&lt 2 DE_X       &kp DE_J            &kp DE_M            &kp DE_B              &kp DE_F      &kp DE_Y              &kp DE_G              &kp DE_SLASH        &kp DE_COMMA        &lt 2 DE_DOT
                                                                               &lt 1 DE_S    &mt LEFT_SHIFT SPACE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                    &kp DE_PERCENT   &kp DE_ASTRK  &kp DE_UNDER                                     &kp DE_MINUS  &kp DE_PLUS   &kp DE_EQUAL
&kp N1              &kp N2           &kp N3        &kp N4            &kp N5          &kp N6         &kp N7        &kp N8        &kp N9        &kp N0
&kp DE_EXCLAMATION  &kp DE_QUESTION  &kp DE_AT     &kp DE_AMPERSAND  &kp DE_CARET    &kp DE_DOLLAR  &kp DE_HASH   &kp DE_GRAVE  &kp DE_COMMA  &kp DOT
                                                                     &trans          &lt 2 ENTER
            >;
        };

        nav {
            bindings = <
           &kp LC(TAB)  &kp LC(LS(TAB))  &kp LC(F4)                              &kp PG_DN    &kp PG_UP  &trans
&sk LCTRL  &sk LALT     &sk LGUI         &sk LSHFT    &trans          &kp LEFT   &kp DOWN     &kp UP     &kp RIGHT  &trans
&trans     &kp LA(TAB)  &kp LA(LS(TAB))  &key_repeat  &kp LG(DE_Q)    &kp HOME   &key_repeat  &trans     &kp END    &trans
                                                      &trans          &kp ENTER
            >;
        };

        cfg_layer {
            display-name = "Cfg";
            bindings = <
           &none  &none  &none                       &none         &none         &none
&kp Q      &none  &none  &none  &none    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
&soft_off  &none  &none  &none  &none    &none       &none         &none         &none         &bt BT_CLR_ALL
                                &none    &none
            >;
        };
    };
};
